{
  "name": "saboteur",
  "version": "0.1.0",
  "private": true,
  "description": "Plant real bugs in your live app and find out which ones your TestSprite suite misses.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "audit": "npm audit --audit-level=low",
    "verify": "./verify.sh",
    "saboteur": "node scripts/saboteur.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
